{
  "mcpServers": {
    "studyloop-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/path/to/studyloop/packages/studyloop",
        "studyloop-mcp"
      ]
    },
    "speaker": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp[cli]",
        "mcp",
        "run",
        "/path/to/studyloop/agents/mcp/study-speak-server.py"
      ]
    }
  }
}
