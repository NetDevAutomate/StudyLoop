{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/openspec-gate.py pre-tool-use",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/openspec-gate.py remind",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
