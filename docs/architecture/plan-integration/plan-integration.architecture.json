    {
      "dot": "cyan",
      "title": "Six seam operations",
      "items": [
        "browse \u00b7 inspect \u00b7 prepare_planning \u2192 frozen views",
        "get_active_guidance(today=) \u2192 one per active plan",
        "apply \u2192 PlanDetail | DeleteResult \u00b7 assess \u2192 result"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nine MCP plan tools",
      "items": [
        "list \u00b7 get \u00b7 get_planning_interview \u00b7 create \u00b7 update",
        "set_status is readiness-gated \u00b7 set_milestone is a set",
        "evaluate: preview | record \u00b7 delete: confirmed=true"
      ]
    },
    {
      "dot": "rose",
      "title": "Plan-aware now, not automatic",
      "items": [
        "a bounded bias, never a filter; no plan \u2192 the golden",
        "no live-session binding, no plan id on session state",
        "no session-driven checkpoints or milestones; no single-active rule"
      ]
    }
